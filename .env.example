# Public source identity. Push this directory to a public GitHub repository and
# replace both placeholders with the repository URL and immutable commit.
SERVICE_SOURCE_URL=https://github.com/YOUR_ORG/cape-roof-geometry
SERVICE_COMMIT=0000000000000000000000000000000000000000

# Generate at least 32 random bytes. Use the same value for the Apps Script
# OPEN_SOURCE_GEOMETRY_TOKEN property.
AUTH_BEARER_TOKEN=replace-with-a-long-random-production-token

# Stable upstream versions pinned by the image and provenance response.
ROOFER_VERSION=1.0.0
ROOFER_COMMIT=bb2a85a99c424001e698dac0e97485a5da31e27e
PDAL_VERSION=2.9.2
OVERTUREMAPS_VERSION=1.0.1
OVERTURE_RELEASE=2026-08-19.0
MICROSOFT_BFP_ENABLED=true
MICROSOFT_BFP_RELEASE=2026-07-24
MICROSOFT_BFP_CATALOG_URL=https://bfppub.blob.core.windows.net/$web/2026-07-24/dataset-links.csv
MICROSOFT_BFP_ZOOM=9
MICROSOFT_BFP_MAXIMUM_TILE_BYTES=100000000
OSM_FOOTPRINT_ENABLED=true
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_CACHE_SECONDS=604800
LEE_COUNTY_FOOTPRINT_URL=https://gismapserver.leegov.com/gisserver910/rest/services/DataExplorer/LandRecords/MapServer/8/query
SOLAR_MASK_SIMPLIFICATION_TOLERANCE_METERS=0.15
FOOTPRINT_CONSENSUS_MIN_IOU=0.80
FOOTPRINT_CORRELATED_MIN_IOU=0.70
FOOTPRINT_MAXIMUM_CENTROID_SEPARATION_METERS=2
FOOTPRINT_MAXIMUM_AREA_DIFFERENCE_PERCENT=10
FOOTPRINT_REVIEW_AREA_DIFFERENCE_PERCENT=20
MINIMUM_ROOF_HAG_METERS=1.5
MAXIMUM_ROOF_HAG_METERS=25
ROOF_CLUSTER_TOLERANCE_METERS=1.5
MINIMUM_ROOF_CLUSTER_POINTS=20

# Southwest Florida abuse boundary and reliability thresholds.
SERVICE_MIN_LONGITUDE=-83.25
SERVICE_MAX_LONGITUDE=-80.50
SERVICE_MIN_LATITUDE=25.50
SERVICE_MAX_LATITUDE=28.25
MAXIMUM_LIDAR_AGE_YEARS=10
MINIMUM_LIDAR_ACQUISITION_DATE=2018-01-01
MINIMUM_POINT_DENSITY=8
MAXIMUM_NODATA_FRACTION=0.10
MAXIMUM_ROOFER_RMSE_METERS=0.35
ROOF_EDGE_VERTICAL_NODE_TOLERANCE_METERS=0.30
ROOF_PLANE_INTERSECTION_MAXIMUM_DISPLACEMENT_METERS=0.35
ROOF_SHARED_EDGE_MAXIMUM_DIRECTION_VARIANCE_DEGREES=5
ROOF_EXTERIOR_BOUNDARY_MAXIMUM_DISTANCE_METERS=0.50
MAXIMUM_ROOFPRINT_PERIMETER_VARIANCE_PERCENT=10
MINIMUM_SERVICE_CONFIDENCE=0.80
MAX_CONCURRENT_JOBS=2
CATALOG_DOWNLOAD_TIMEOUT_SECONDS=180
CATALOG_MAXIMUM_BYTES=200000000
MINIMUM_LIDAR_COVERAGE_RATIO=0.98
CURRENT_LIDAR_MAX_AGE_YEARS=2
MAXIMUM_CURRENT_IMAGERY_AGE_YEARS=2
ALLOW_HISTORICAL_VERIFIED_PRICING=true
LIDAR_REGISTRY_PATH=/srv/cape-roof-geometry/config/lidar_sources.yaml
IMAGERY_REGISTRY_PATH=/srv/cape-roof-geometry/config/imagery_sources.yaml

# Caddy hostname used by deploy/docker-compose.yml.
GEOMETRY_DOMAIN=geometry.caperoof.com
